# ── LLM Providers ─────────────────────────────────────────────────────────────
# Primary provider for all pipeline stages (plan, codegen, observe, critique)
GROQ_API_KEY=your_groq_api_key_here

# Fallback provider — used automatically when Groq is unavailable
GEMINI_API_KEY=your_gemini_api_key_here

# ── Pipeline Tuning (optional overrides) ───────────────────────────────────────
# Maximum PLAN→CODEGEN→EXECUTE→OBSERVE→CRITIQUE iterations per sub-question
# MAX_RETRIES=3

# Wall-clock timeout (seconds) for sandbox code execution
# SANDBOX_TIMEOUT_SECONDS=30

# Directory where JSONL run logs are written
# LOG_DIR=runs
