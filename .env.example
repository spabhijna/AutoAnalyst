# ── LLM Providers ─────────────────────────────────────────────────────────────
# Primary provider for all pipeline stages (plan, codegen, observe, critique)
GROQ_API_KEY=your_groq_api_key_here

# Fallback provider (Cerebras — separate rate limits from Groq)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Fallback provider (OpenRouter — OpenAI-compatible gateway)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fallback provider (Google AI Studio / Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Pipeline Tuning (optional overrides) ───────────────────────────────────────
# Maximum PLAN→CODEGEN→EXECUTE→OBSERVE→CRITIQUE iterations per sub-question
# MAX_RETRIES=3

# Wall-clock timeout (seconds) for sandbox code execution
# SANDBOX_TIMEOUT_SECONDS=30

# Directory where JSONL run logs are written
# LOG_DIR=runs
